# ./init-env.sh generates a private .env with new random passwords.
# Image references are replaced with release-specific tags in a download bundle.
CAMPUS_APP_IMAGE=campusjudge:local
CAMPUS_RUNNER_IMAGE=campusjudge-runner:local
CAMPUS_POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_PASSWORD=
CAMPUS_TEACHER_PASSWORD=
CAMPUS_BIND_ADDRESS=127.0.0.1
CAMPUS_PORT=8080
CAMPUS_TRUSTED_PROXIES=
CAMPUS_DOCKER_SOCKET=/var/run/docker.sock
CAMPUS_VOLUME_NAME=campusjudge-server-postgres
